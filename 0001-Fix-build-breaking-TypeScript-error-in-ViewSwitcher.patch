From d6009cbc90b2b866f09ac365b1d6d24c5ca55885 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 13 Sep 2026 09:29:03 +0000
Subject: [PATCH] Fix build-breaking TypeScript error in ViewSwitcher
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

icons was declared in the props type but never destructured out of the
function's parameters, so referencing it inside the component was an
undefined name — passed local type-checking in my sandbox somehow but
failed the real Next.js production build ("Cannot find name 'icons'").
Every deploy since the "Overview" label commit landed has been failing
at build time, which is why none of the fixes after it (including that
one) ever actually went live despite being correctly on origin/main.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AkznvRLnBokzbdmJ2WwaEM
---
 src/app/dashboard/runs/[id]/_shared/view-switcher.tsx | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/app/dashboard/runs/[id]/_shared/view-switcher.tsx b/src/app/dashboard/runs/[id]/_shared/view-switcher.tsx
index 7cbb13e..152975b 100644
--- a/src/app/dashboard/runs/[id]/_shared/view-switcher.tsx
+++ b/src/app/dashboard/runs/[id]/_shared/view-switcher.tsx
@@ -17,6 +17,7 @@ export function ViewSwitcher({
   className,
   modes,
   labels,
+  icons,
 }: {
   value: RunViewMode;
   onChange: (mode: RunViewMode) => void;
-- 
2.43.0

