+          const payload = { ...(row.payload as Record<string, unknown>), _digestedAt: now };
+          await db.update(pendingActions).set({ payload }).where(eq(pendingActions.id, row.id));
+        }
+      });
+    }
+
+    return { engagementsPinged, itemsDigested: undigested.length };
+  }
