diff --git a/src/app/globals.css b/src/app/globals.css
index 3791707..4276fc4 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -299,6 +299,89 @@
   background-image: radial-gradient(#3f3f46 0.5px, transparent 0.5px);
 }
 
+/* ────────────────────────────────────────────────────────────────────── */
+/* ELEVATION SYSTEM                                                       */
+/* Replaces the one-off "rounded-lg border border-zinc-200/70 dark:border-*/
+/* zinc-800/70 bg-transparent/bg-white/bg-zinc-900 backdrop-blur-sm" combo */
+/* copy-pasted across 100+ files with three tokens every elevated surface  */
+/* pulls from instead: a diffused (never single hard) shadow pair per     */
+/* tier, tinted from ink/black rather than pure black; a translucent glass */
+/* fill so backdrop-blur has something to blur against instead of         */
+/* bg-transparent leaving it inert; and a slight-overshoot spring curve   */
+/* for press/settle feedback instead of a flat opacity dim. No gradients  */
+/* anywhere in this system by design. */
+/* ────────────────────────────────────────────────────────────────────── */
+:root {
+  --shadow-elevation-1: 0 1px 2px rgba(28, 24, 38, 0.05), 0 1px 1px rgba(28, 24, 38, 0.04);
+  --shadow-elevation-2: 0 2px 6px rgba(28, 24, 38, 0.06), 0 10px 24px rgba(28, 24, 38, 0.07);
+  --shadow-elevation-3: 0 4px 10px rgba(28, 24, 38, 0.08), 0 20px 44px rgba(28, 24, 38, 0.10);
+  --shadow-inset-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.55);
+  --surface-glass: color-mix(in oklch, var(--card) 72%, transparent);
+  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
+}
+
+.dark {
+  --shadow-elevation-1: 0 1px 2px rgba(0, 0, 0, 0.32), 0 1px 1px rgba(0, 0, 0, 0.22);
+  --shadow-elevation-2: 0 2px 8px rgba(0, 0, 0, 0.36), 0 10px 28px rgba(0, 0, 0, 0.32);
+  --shadow-elevation-3: 0 4px 12px rgba(0, 0, 0, 0.42), 0 20px 48px rgba(0, 0, 0, 0.46);
+  --shadow-inset-highlight: inset 0 1px 0 rgba(255, 255, 255, 0.07);
+  --surface-glass: color-mix(in oklch, var(--card) 62%, transparent);
+}
+
+/* Elevated surfaces (cards, panels, popovers, modals) — glass fill over a
+   real blur, diffused shadow, thin inset top highlight. Three tiers only:
+   1 for resting content, 2 for cards that sit above the page, 3 for
+   floating overlays (modals, dropdowns). */
+.surface-glass-1,
+.surface-glass-2,
+.surface-glass-3 {
+  background: var(--surface-glass);
+  border: 1px solid var(--border);
+  -webkit-backdrop-filter: blur(16px);
+  backdrop-filter: blur(16px);
+}
+.surface-glass-1 {
+  box-shadow: var(--shadow-elevation-1), var(--shadow-inset-highlight);
+}
+.surface-glass-2 {
+  box-shadow: var(--shadow-elevation-2), var(--shadow-inset-highlight);
+}
+.surface-glass-3 {
+  -webkit-backdrop-filter: blur(24px);
+  backdrop-filter: blur(24px);
+  box-shadow: var(--shadow-elevation-3), var(--shadow-inset-highlight);
+}
+
+/* Flat solid surfaces (buttons) that still need real depth without a
+   glass fill — shadow tiers alone, no blur/translucency. */
+.shadow-elevation-1 {
+  box-shadow: var(--shadow-elevation-1);
+}
+.shadow-elevation-2 {
+  box-shadow: var(--shadow-elevation-2);
+}
+.shadow-elevation-3 {
+  box-shadow: var(--shadow-elevation-3);
+}
+
+/* Hover: a small lift, shadow grows one tier. Press: settles back down
+   with a slight overshoot instead of stopping dead, and the shadow
+   compresses to read as "pressed in." Both keyed off transform + shadow
+   only — no color/opacity shift, no gradient. */
+.hover-lift {
+  transition: transform 200ms var(--ease-spring), box-shadow 200ms ease-out;
+}
+.hover-lift:hover {
+  transform: translateY(-1px);
+}
+.press-settle {
+  transition: transform 150ms var(--ease-spring), box-shadow 150ms ease-out;
+}
+.press-settle:active {
+  transform: scale(0.97) translateY(0);
+  box-shadow: var(--shadow-elevation-1);
+}
+
 @layer base {
   * {
     @apply border-border outline-ring/50;
