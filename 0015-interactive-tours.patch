+/** Same 3-step shape for every product — the mechanics (status tabs, the
+ * onboarding-gate concept, the skill list) are identical across all 4;
+ * only the copy and which row to point at change. See this file's own
+ * header for why this is generated instead of 4 hand-written tours. */
+function buildProductTour(spec: ProductTourSpec): TourDefinition {
+  return {
+    id: spec.id,
+    label: spec.label,
+    description: spec.description,
+    steps: [
+      {
+        id: "status-tabs",
+        route: spec.productPath,
+        target: '[data-tour="product-status-tabs"]',
+        title: `${spec.label}'s skills`,
+        body: `Filter this worker's own skill list by what's already enabled — everything here belongs to ${spec.label} specifically.`,
+        placement: "bottom",
+      },
+      {
+        id: "onboarding-worker",
+        route: spec.productPath,
+        target: `[data-tour="worker-row-${spec.onboardingWorkerId}"]`,
+        title: spec.onboardingWorkerName,
+        body: `This is where ${spec.label} starts. Every other skill in it stays locked until this one actually runs for this client — not just switched on, actually completed.`,
+        placement: "top",
+      },
+      {
+        id: "skill-list",
+        route: spec.productPath,
+        target: '[data-tour="product-skill-list"]',
+        title: "Enable the rest",
+        body: `Once ${spec.onboardingWorkerName} has run, every other ${spec.label} skill enables normally from this same list.`,
+        placement: "top",
