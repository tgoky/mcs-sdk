+// Manager, Cold Open, Whop Agent) plus "dashboard-basics" and
+// "engagement-detail" for the pages that aren't product-scoped, and a
+// "full-walkthrough" that's just all of them concatenated — so a first-
+// time user can either pick exactly what they need or take the whole
+// thing in one pass (both options live in the tour picker, see
+// tour-launcher.tsx).
+//
+// Every product tour is generated by buildProductTour() rather than
+// hand-written 4 times — the Library's per-skill mechanics (Configure/
+// Analytics/status filters/the onboarding gate) are the literally same
+// UI across all 4 products (see worker-card.tsx), so 4 near-duplicate
+// step lists would just be 4 places to forget to update together.
+
+import type { TourDefinition, TourStep } from "./types";
+
+/** Substitutes `{engagementId}` into a step's route template. Returns
+ * null (meaning "can't resolve this route yet") when the route needs an
+ * engagement and there isn't a primary one for this workspace — the
+ * provider treats that the same as any other step whose target never
+ * appears: skip it. */
+export function resolveTourRoute(route: string, engagementId: string | null): string | null {
+  if (!route.includes("{engagementId}")) return route;
+  if (!engagementId) return null;
+  return route.replace("{engagementId}", engagementId);
+}
+
+const DASHBOARD_BASICS: TourStep[] = [
+  {
