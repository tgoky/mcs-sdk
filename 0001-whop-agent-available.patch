From 7172983d853741d7a5e5e4e2b0a691791e103bb4 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 14 Sep 2026 13:38:12 +0000
Subject: [PATCH] Mark Whop Agent as available now that all 15 playbooks are
 implemented

WORKSPACE_PRODUCTS still hardcoded whop-agent's status as coming_soon,
which gated it out of both workspace creation ("Coming soon", disabled
checkbox) and Library install (installPackageInWorkspace rejected it
with "That product is not available to install.").

The manifest (whop-agent-skill-manifest.ts) already marks all 15
playbooks implemented:true, each backed by a real execute function or
its own dedicated route, an invariant whop-agent-skill-registry.ts
enforces at module load. The coming_soon flag was left over from
before that work landed and was never flipped. Also swap in a
placeholder SVG icon (matching cold-open.svg's style) since the
referenced whop-agent.png was never produced and would 404 once the
product became selectable.
---
 public/images/whop-agent.svg |  7 +++++++
 src/lib/copy.ts              | 18 +++++++++---------
 tests/unit/copy.test.ts      |  6 ++++--
 3 files changed, 20 insertions(+), 11 deletions(-)
 create mode 100644 public/images/whop-agent.svg

diff --git a/public/images/whop-agent.svg b/public/images/whop-agent.svg
new file mode 100644
index 0000000..0a06572
--- /dev/null
+++ b/public/images/whop-agent.svg
@@ -0,0 +1,7 @@
+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64" role="img" aria-label="Whop Agent">
+  <rect x="1" y="1" width="62" height="62" rx="14" fill="#18181b"/>
+  <rect x="1" y="1" width="62" height="62" rx="14" fill="none" stroke="#3f3f46" stroke-width="1"/>
+  <circle cx="22" cy="32" r="8" fill="none" stroke="#fbbf24" stroke-width="2.5"/>
+  <circle cx="42" cy="32" r="8" fill="none" stroke="#fbbf24" stroke-width="2.5"/>
+  <path d="M29 32 L35 32" fill="none" stroke="#fbbf24" stroke-width="2.5" stroke-linecap="round"/>
+</svg>
diff --git a/src/lib/copy.ts b/src/lib/copy.ts
index 505e896..8b2b010 100644
--- a/src/lib/copy.ts
+++ b/src/lib/copy.ts
@@ -647,15 +647,15 @@ export const WORKSPACE_PRODUCTS: WorkspaceProduct[] = [
     description:
       "Connect a Whop seller account and run curated ops playbooks against it: launch pre-flight, cancellation save-offers, dispute response, webhook fleet health, and portfolio reporting — every write verified and gated.",
     href: "/dashboard/library/whop-agent",
-    // coming_soon until enough of the 14 playbooks in
-    // whop-agent-skill-manifest.ts are marked implemented:true to be a
-    // real product, not just the connect flow + webhook subsystem — see
-    // that file's own implemented flag, not asserted here independently.
-    status: "coming_soon",
-    // Real artwork not produced yet — same placeholder gap this app's own
-    // convention (WORKSPACE_PRODUCTS' other entries all ship real images)
-    // flags rather than silently reusing an unrelated icon.
-    image: "/images/whop-agent.png",
+    // All 15 playbooks in whop-agent-skill-manifest.ts are now
+    // implemented:true, each with a real execute function or its own
+    // dedicated route (enforced by whop-agent-skill-registry.ts's
+    // module-load invariant) — a real product, not just the connect flow
+    // + webhook subsystem.
+    status: "available",
+    // Simple placeholder icon in the same style as cold-open.svg — real
+    // artwork not produced yet.
+    image: "/images/whop-agent.svg",
   },
 ];
 
diff --git a/tests/unit/copy.test.ts b/tests/unit/copy.test.ts
index 766f07b..9eeb340 100644
--- a/tests/unit/copy.test.ts
+++ b/tests/unit/copy.test.ts
@@ -133,10 +133,12 @@ describe("HOME_COPY / WORKSPACE_PRODUCTS", () => {
     }
   });
 
-  it("exposes the two currently installable products at their own entry points", () => {
+  it("exposes the currently installable products at their own entry points", () => {
     const available = WORKSPACE_PRODUCTS.filter((p) => p.status === "available");
-    expect(available.map((p) => p.id).sort()).toEqual(["reputation-manager", "showtime"]);
+    expect(available.map((p) => p.id).sort()).toEqual(["cold-open", "reputation-manager", "showtime", "whop-agent"]);
     expect(available.find((p) => p.id === "showtime")?.href).toBe("/dashboard");
     expect(available.find((p) => p.id === "reputation-manager")?.href).toBe("/dashboard/reputation-manager");
+    expect(available.find((p) => p.id === "cold-open")?.href).toBe("/dashboard/library/cold-open");
+    expect(available.find((p) => p.id === "whop-agent")?.href).toBe("/dashboard/library/whop-agent");
   });
 });
-- 
