button's own radius reduction. Only used by skill-configure-menu.tsx,
so this doesn't touch any other popover/panel in the app.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AkznvRLnBokzbdmJ2WwaEM
---
 src/components/floating-panel.tsx | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/components/floating-panel.tsx b/src/components/floating-panel.tsx
index 6bd2e45..115b30a 100644
--- a/src/components/floating-panel.tsx
+++ b/src/components/floating-panel.tsx
@@ -93,7 +93,7 @@ export function FloatingPanel({
               <div
                 ref={panelRef}
                 role="dialog"
-                className="rounded-2xl surface-glass-3 text-zinc-900 dark:text-zinc-100 max-h-[80vh] overflow-y-auto font-sans antialiased"
+                className="rounded-lg surface-glass-3 text-zinc-900 dark:text-zinc-100 max-h-[80vh] overflow-y-auto font-sans antialiased"
               >
                 {typeof children === "function" ? children(close) : children}
               </div>
