+import type { UnifiedActivityItem, UnifiedActivityCounts, UnifiedActivityStatus } from "@/lib/unified-activity";
+
+const PRODUCT_LABELS: Record<ProductId, string> = {
+  showtime: "Showtime",
+  "reputation-manager": "Reputation Manager",
