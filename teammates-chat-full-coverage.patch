Missed staging this guard in the previous commit — assemblePurchaseCapPacketForEngagement
was calling out to Whop with unvalidated (possibly NaN) cent amounts if the model omitted
a required field, instead of failing fast like every other whop-agent wrapper in this file.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QRxyo1ZXhb7Jft7LdiA4Ve
---
 src/lib/chat-whop-agent.ts | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/lib/chat-whop-agent.ts b/src/lib/chat-whop-agent.ts
index 5cfc46e..06ccadd 100644
--- a/src/lib/chat-whop-agent.ts
+++ b/src/lib/chat-whop-agent.ts
@@ -109,6 +109,9 @@ export async function assemblePurchaseCapPacketForEngagement(
 ): Promise<ActionResult> {
   const denied = await requireAccess(session, engagementId);
   if (denied) return { ok: false, error: denied };
+  if (!Number.isFinite(input.highestPricedOfferCents) || !Number.isFinite(input.targetApprovalAmountCents) || !input.contactEmail) {
+    return { ok: false, error: "highestPricedOfferCents, targetApprovalAmountCents, and contactEmail are required." };
+  }
   try {
