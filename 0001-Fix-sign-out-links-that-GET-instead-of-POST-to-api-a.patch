From 748b70e14bb7638f3dc82bfbde522abeb311e4da Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 14 Sep 2026 12:39:39 +0000
Subject: [PATCH 1/2] Fix sign-out links that GET instead of POST to
 /api/auth/logout
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The logout route only handles POST, but the mobile nav sign-out link
and the workspace home page sign-out link were plain <a>/<Link>
navigations (GET), which 405'd against the route and left the session
cookie intact — users appeared to sign out but stayed logged in.
Switch both to POST forms, matching the working desktop sign-out in
primary-rail.tsx.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QxF9pja3hAyT4tJNN6dTRK
---
 src/app/dashboard/mobile-nav.tsx | 15 ++++++++-------
 src/app/home/page.tsx            | 16 ++++++++--------
 tests/unit/home-page.test.tsx    |  6 ++++--
 tests/unit/mobile-nav.test.tsx   |  6 ++++--
 4 files changed, 24 insertions(+), 19 deletions(-)

diff --git a/src/app/dashboard/mobile-nav.tsx b/src/app/dashboard/mobile-nav.tsx
index 67451f5..0a22581 100644
--- a/src/app/dashboard/mobile-nav.tsx
+++ b/src/app/dashboard/mobile-nav.tsx
@@ -69,13 +69,14 @@ export function MobileNav({ links, displayName }: { links: NavLink[]; displayNam
                 <span className="text-sm text-zinc-800 dark:text-zinc-300 font-bold font-mono truncate max-w-[160px]">
                   {displayName}
                 </span>
-                <a
-                  href="/api/auth/logout"
-             
-                  className="text-xs font-mono text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors"
-                >
-                  Sign out
-                </a>
+                <form action="/api/auth/logout" method="POST">
+                  <button
+                    type="submit"
+                    className="text-xs font-mono text-zinc-400 dark:text-zinc-500 hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors bg-transparent border-none cursor-pointer"
+                  >
+                    Sign out
+                  </button>
+                </form>
               </div>
             )}
           </div>
