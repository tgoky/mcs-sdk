diff --git a/src/lib/avatar.ts b/src/lib/avatar.ts
index a948baf..fc79fba 100644
--- a/src/lib/avatar.ts
+++ b/src/lib/avatar.ts
@@ -34,6 +34,25 @@ export function seedsForStyle(count = 25): string[] {
