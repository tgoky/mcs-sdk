# Environment settings this app reads. Copy to .env.local for development
# and set the same names in production. Values here are placeholders.
# Leave a line blank to switch that feature off; required ones say so.

# ── Core (required) ──────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/db
# Public origin of the app, used in links and webhook addresses.
NEXT_PUBLIC_APP_URL=https://app.example.com
# Signs login sessions.
SESSION_SECRET=
# Signs the per-client token in webhook addresses (reply forwarding,
# bounce/complaint feeds). Keep it separate from SESSION_SECRET so the login
# secret can rotate without breaking every client's webhook address. When
# first setting it on an existing install, use the current SESSION_SECRET
# value so the addresses already handed out keep working.
WEBHOOK_URL_SECRET=
# Addresses handed out before they carried a token work until this date.
WEBHOOK_TOKEN_GRACE_UNTIL=2026-10-24T00:00:00Z
# Encrypts saved credentials. Bump the version when rotating the key.
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Authenticates scheduled jobs calling /api/crons/*.
CRON_SECRET=

# ── Models ───────────────────────────────────────────────────────────────
# Claude calls go to Anthropic directly unless USE_OPENROUTER=true.
USE_OPENROUTER=true
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Jev: "openrouter" sends it through OPENROUTER_API_KEY; otherwise it calls
# Typesafe directly with TYPESAFE_API_KEY.
JEV_TRANSPORT=openrouter
TYPESAFE_API_KEY=
# Jev is pinned to the version its thresholds were set against (jev.ts,
# JEV_PINNED_VERSION). Set a full model id here to override it, e.g.
# typesafe/jev-1.13.0; re-check thresholds with /api/admin/jev-agreement first.
JEV_MODEL=

# ── Reputation Manager ───────────────────────────────────────────────────
# AI Engine Watch asks each engine whose model is set here (OpenRouter model
# ids, e.g. openai/gpt-5). An engine left blank isn't offered; with none set
# the setup says no AI engine is available.
REP_ENGINE_MODEL_CHATGPT=
REP_ENGINE_MODEL_CLAUDE=
REP_ENGINE_MODEL_PERPLEXITY=
REP_ENGINE_MODEL_GROK=
REP_ENGINE_MODEL_GEMINI=
# Google listing, reviews and search.
OUTSCRAPER_API_KEY=
REDDITAPIS_API_KEY=
TWITTERAPIS_API_KEY=
# Crisis Response paging by text.
REP_PAGING_TWILIO_ACCOUNT_SID=
REP_PAGING_TWILIO_AUTH_TOKEN=
REP_PAGING_TWILIO_FROM_NUMBER=

# ── Composio (Sign in with a tool) ───────────────────────────────────────
COMPOSIO_API_KEY=
# Our own Composio auth config ("ac_...") per toolkit. Required before Sign
# in is offered for Klaviyo and HighLevel (Composio has no ready-made login
# for them); optional for the others, to show our own app on the consent
# screen. These are identifiers, not secrets.
NEXT_PUBLIC_COMPOSIO_AUTH_CONFIG_KLAVIYO=
NEXT_PUBLIC_COMPOSIO_AUTH_CONFIG_HIGHLEVEL=
NEXT_PUBLIC_COMPOSIO_AUTH_CONFIG_CALENDLY=
NEXT_PUBLIC_COMPOSIO_AUTH_CONFIG_HUBSPOT=
NEXT_PUBLIC_COMPOSIO_AUTH_CONFIG_MAILCHIMP=
NEXT_PUBLIC_COMPOSIO_AUTH_CONFIG_SLACK=

# ── Whop (app login and billing) ─────────────────────────────────────────
WHOP_API_KEY=
WHOP_CLIENT_ID=
WHOP_CLIENT_SECRET=
WHOP_REDIRECT_URI=
WHOP_WEBHOOK_SECRET=
WHOP_COMPANY_ID=
WHOP_PLAN_ID=
WHOP_COMPANY_CHECKOUT_URL=
# Comma-separated product ids that grant access, and admin emails.
WHOP_ACCESS_PRODUCT_IDS=
ADMIN_WHOP_EMAILS=

# ── Email and other services ─────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FIRECRAWL_API_KEY=
HUBSPOT_APP_ID=
HUBSPOT_APP_CLIENT_SECRET=

# ── Operations ───────────────────────────────────────────────────────────
# Error monitoring (lib/error-reporting.ts). Every server error, failed
# background job and page crash goes here. Either, both or neither.
SENTRY_DSN=
# A Slack incoming-webhook URL for your own alerts (one per distinct error
# every 15 minutes).
ERROR_ALERT_SLACK_WEBHOOK_URL=
# Runs older than this are marked stale.
STALE_RUN_CEILING_MINUTES=120
# A client the canary checks run against, and where they alert.
CANARY_ENGAGEMENT_ID=
CANARY_ALERT_SLACK_WEBHOOK_URL=
