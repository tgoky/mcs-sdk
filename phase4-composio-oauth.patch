+  const row = { ...initialRow };
+  const setCalls: Array<Record<string, unknown>> = [];
+
+  const db = {
+    select: vi.fn(() => ({
+      from: () => ({
+        where: () => ({
+          limit: async () => [{ refKey: row.refKey }],
+        }),
+      }),
+    })),
+    update: vi.fn(() => ({
+      set: (patch: Record<string, unknown>) => {
+        setCalls.push(patch);
+        return {
+          where: async () => {
+            Object.assign(row, patch);
+          },
+        };
+      },
+    })),
