From f92ffbb518710ce49bb05dcf5730ea2185122d61 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 10 Sep 2026 11:34:31 +0000
Subject: [PATCH 2/4] Fix GlowBacklight bleeding outside the card's edges
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Real bug, not a style call: blur-2xl spreads visually far past an
element's own box (~40px+ kernel), and the previous position (top-4 /
bottom-4, i.e. only 16px from the card's edge) put nowhere near enough
margin between the glow and the card boundary — the blurred shape spilled
straight past the rounded corner onto the page behind it, visible as a
raw white blob instead of a contained interior bloom (see the "Showtime"
card screenshot).

Fix: percentage-based inset (15% from the sides, 12% from the top,
sized to a 1/5-height band) so the margin scales with the card instead
of a fixed pixel gap that only worked for one specific card size, and
blur-lg instead of blur-2xl to shrink the visual spread to something
that actually fits inside that margin.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_013tmyB4bNsymQY5xKRXZJD7
---
 src/components/ui/glow-backlight.tsx | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/src/components/ui/glow-backlight.tsx b/src/components/ui/glow-backlight.tsx
index 58eac54..2b0c760 100644
--- a/src/components/ui/glow-backlight.tsx
+++ b/src/components/ui/glow-backlight.tsx
@@ -15,9 +15,16 @@
  *   </div>
  */
 export function GlowBacklight({
-  className = "absolute top-4 left-1/2 -translate-x-1/2 h-16 w-3/4",
+  className = "absolute inset-x-[15%] top-[12%] h-1/5",
 }: {
   className?: string;
 }) {
-  return <div aria-hidden="true" className={`${className} rounded-full bg-white/80 dark:bg-white/70 blur-2xl pointer-events-none`} />;
+  // Inset generously from every edge, as a percentage of the card's own
+  // size rather than fixed pixels — blur-lg's ~16px visual spread has to
+  // stay inside that margin regardless of how big or small the card
+  // actually is, or the glow shows up as a raw shape outside the card's
+  // border instead of a contained interior bloom (the bug this replaces:
+  // a fixed 40px+ blur positioned only 16px from the edge, which bled
+  // straight past the card's bottom edge onto the page).
+  return <div aria-hidden="true" className={`${className} rounded-full bg-white/80 dark:bg-white/70 blur-lg pointer-events-none`} />;
 }
-- 
2.43.0


From c8f1db9250fc1b365f243c49b992320234c0c4be Mon Sep 17 00:00:00 2001
