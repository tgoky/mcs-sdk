+  "send-report": { bgClass: "bg-[#e5e7eb]", icon: BarChart3 }, // neutral gray — reporting
+};
+
+export function ColdOpenSkillBadge({ skill, size = 20 }: { skill: ColdOpenSkillId; size?: number }) {
